# Optional, server-side only: API-Football injuries for Bundesliga, Premier League, LaLiga and Ligue 1.
# Never commit a real key. Configure API_FOOTBALL_KEY in Vercel > Project > Settings > Environment Variables.
# Without this key, football availability depends on ESPN injury-feed coverage.
API_FOOTBALL_KEY=

# V2.8 - Login with Sorare (server-side only): create OAuth app at sorare.com/settings/developer
# Set the same values in Vercel Project Settings > Environment Variables, never put real secrets in Git.
SORARE_SITE_URL=https://markerrasorarev1.vercel.app
SORARE_OAUTH_CLIENT_ID=
SORARE_OAUTH_CLIENT_SECRET=
# Generate random 32+ bytes (e.g. with node: require('crypto').randomBytes(48).toString('hex'))
SORARE_SESSION_SECRET=
# Optional higher authenticated Sorare rate limit - never expose it to frontend
SORARE_API_KEY=

# V3.4 – Fully automatic Prediction Learning Lab (once-only Vercel setup).
# Add an Upstash Redis database to Vercel; set these as server-side env variables.
# NEVER put credentials in NEXT_PUBLIC_* or commit them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret with 16+ characters, recommended 32+; Vercel Cron authenticates as Bearer.
CRON_SECRET=

# V4.4 Adaptive Learning (Neon PostgreSQL statt Upstash)
# Einmalig schema/learning-v44.sql in Neon ausführen.
DATABASE_URL=
# Langes zufälliges Secret, nur serverseitig in Vercel hinterlegen.
CRON_SECRET=
# Nur nach erfolgreichem Live-Daten- und Holdout-Test freigeben.
V44_AUTO_PROMOTE=false
